rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. 게시물 규칙 (Posts)
    match /posts/{postId} {
      allow read: if true;
      allow create: if true;
      // 작성자 본인이거나 총관리자인 경우에만 수정/삭제 가능
      allow update, delete: if request.auth != null && 
        (request.auth.uid == resource.data.uid || request.auth.token.email == 'anstlr6665@gmail.com');
    }

    // 2. 출석부 규칙 (Attendance)
    match /attendance/{attendanceId} {
      allow read: if true;
      allow create: if request.auth != null;
      
      // 🔥 관리자(anstlr6665@gmail.com)에게 수정 및 삭제(delete) 권한 부여!
      allow update, delete: if request.auth != null && 
        (request.auth.token.email == 'anstlr6665@gmail.com');
    }

    // 3. 오류 정정 제안 규칙 (Error Reports)
    match /error_reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null && 
        (request.auth.uid == (resource != null && 'uid' in resource.data ? resource.data.uid : '') || request.auth.token.email == 'anstlr6665@gmail.com');
    }

    // 4. 위키식 수정 페이지 규칙 (Custom Pages)
    match /custom_pages/{pageId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && 
        request.auth.token.email == 'anstlr6665@gmail.com';
    }

    // 5. 사용자 규칙 (Users)
    match /users/{userId} {
      // 본인이거나, 프로필이 공개되어 있거나, 관리자인 경우 또는 비로그인 상태라도 프로필이 공개되어 있으면 읽기 허용
      allow read: if (resource != null && resource.data.isProfilePublic == true) || 
        (request.auth != null && (
          request.auth.uid == userId || 
          request.auth.token.email == 'anstlr6665@gmail.com'
        ));
      // 로그인한 사용자가 자신의 문서를 생성하거나 관리자가 생성하는 것 허용
      allow create: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.email == 'anstlr6665@gmail.com'
      );
      allow update: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.email == 'anstlr6665@gmail.com' ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount']))
      );
      // 삭제는 본인 또는 관리자만
      allow delete: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.token.email == 'anstlr6665@gmail.com'
      );
    }

    // 6. 팔로우 규칙 (Follows)
    match /follows/{followId} {
      // 로그인한 유저는 읽기 가능
      allow read: if request.auth != null;
      // 팔로우 관계를 맺는 사람 본인만 생성/삭제 가능
      allow create: if request.auth != null && request.auth.uid == request.resource.data.followerUid;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.followerUid || request.auth.token.email == 'anstlr6665@gmail.com');
    }

    // 7. 포인트 내역 규칙 (Point History)
    match /point_history/{historyId} {
      // 본인이거나 관리자인 경우만 읽기 가능
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid || 
        request.auth.token.email == 'anstlr6665@gmail.com'
      );
      // 포인트 기록 생성은 로그인한 유저 누구나 가능
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.email == 'anstlr6665@gmail.com';
    }

    // 8. 실시간 채팅 규칙 (LiveChat)
    match /livechat/{msgId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.uid || request.auth.token.email == 'anstlr6665@gmail.com');
    }

    // 9. 실시간 채팅 아카이브 규칙 (LiveChat Archives)
    match /livechat_archives/{archiveId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null &&
        request.auth.token.email == 'anstlr6665@gmail.com';
    }
  }
}
